# ============================================================
#  CASTANEAS — .htaccess
# ============================================================

# ── 0. Désactiver le listing des répertoires ──────────────
Options -Indexes
DirectoryIndex index.html

# ── 1. Protéger les données sensibles ─────────────────────
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

# ── 2. Headers de sécurité ────────────────────────────────
<IfModule mod_headers.c>
    # Empêche le clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Empêche le MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Désactive le referrer sur les liens externes
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Content Security Policy (permissif pour un site statique avec Google Fonts)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"
</IfModule>

# ── 4. Forcer HTTPS + URLs propres ───────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 301 — anciens slugs de catégorie vers nouvelles URLs SEO-friendly
    RewriteRule ^creme-de-chataigne\.html$ /categorie/cremes [R=301,L]
    RewriteRule ^pates-tartiner\.html$     /categorie/pates-tartiner [R=301,L]
    RewriteRule ^huiles\.html$             /categorie/huiles [R=301,L]
    RewriteRule ^coffrets\.html$           /categorie/coffrets [R=301,L]
    RewriteRule ^index\.html$              /accueil [R=301,L]
    RewriteRule ^login\.html$              /connexion [R=301,L]
    RewriteRule ^register\.html$           /inscription [R=301,L]
    RewriteRule ^mon-compte\.html$         /mon-compte [R=301,L]
    RewriteRule ^panier\.html$             /panier [R=301,L]
    RewriteRule ^facturation\.html$        /facturation [R=301,L]
    RewriteRule ^confirmation\.html$       /confirmation [R=301,L]
    RewriteRule ^recettes\.html$           /recettes [R=301,L]
    RewriteRule ^recette\.html$            /recette [R=301,L]
    RewriteRule ^actualites\.html$         /actualites [R=301,L]
    RewriteRule ^histoire\.html$           /histoire [R=301,L]
    RewriteRule ^livraison-retours\.html$  /livraison-retours [R=301,L]
    RewriteRule ^cgv\.html$                /cgv [R=301,L]
    RewriteRule ^maintenance\.html$        /maintenance [R=301,L]
    RewriteRule ^back-office\.html$        /back-office [R=301,L]

    # Routes pages propres -> fichiers HTML réels
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^accueil/?$ index.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^connexion/?$ login.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^inscription/?$ register.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^mon-compte/?$ mon-compte.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^panier/?$ panier.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^facturation/?$ facturation.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^confirmation/?$ confirmation.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^recettes/?$ recettes.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^recette/?$ recette.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^actualites/?$ actualites.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^histoire/?$ histoire.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^livraison-retours/?$ livraison-retours.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^cgv/?$ cgv.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^maintenance/?$ maintenance.html [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^back-office/?$ back-office.html [L,QSA]

    # Route /categorie/<slug> → categorie.html?cat=<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^categorie/([^/]+)/?$ categorie.html?cat=$1 [L,QSA]

    # Routes blog
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^actualites/categorie/([^/]+)/?$ actualites.php?category=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^actualites/([^/]+)/([^/]+)/?$ actualite.php?category=$1&slug=$2 [L,QSA]

    # Route /produit/<slug> → produit.php?slug=<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^produit/([^/]+)/?$ produit.php?slug=$1 [L,QSA]

    # Sitemap dynamique
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
</IfModule>

# ── 5. data.php : jamais mis en cache (données dynamiques) ──
<FilesMatch "^data\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Surrogate-Control "no-store"
</FilesMatch>

<FilesMatch "^(back-office|login|register|mon-compte|panier|facturation|confirmation|maintenance)\.html$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</FilesMatch>

<FilesMatch "^(save|upload|storage-status|sendcloud-label|payment-return|payment-notify)\.php$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</FilesMatch>

# ── 5bis. HTML : toujours revalider pour éviter les vieilles pages en prod ──
<FilesMatch "\.(html?)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# ── 6. Cache statique pour les assets ─────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
