# ============================================================
#  CASTANEAS — .htaccess
# ============================================================

# ── 0. Désactiver le listing des répertoires ──────────────
Options -Indexes

# ── 1. Protéger les données sensibles ─────────────────────
<Files "orders.json">
    Require all denied
</Files>

# ── 2. Headers de sécurité ────────────────────────────────
<IfModule mod_headers.c>
    # Empêche le clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # Empêche le MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Désactive le referrer sur les liens externes
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Content Security Policy (permissif pour un site statique avec Google Fonts)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';"
</IfModule>

# ── 4. Forcer HTTPS + URLs propres catégorie ─────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 301 — anciens slugs de catégorie vers nouvelles URLs SEO-friendly
    RewriteRule ^creme-de-chataigne\.html$ /categorie/cremes [R=301,L]
    RewriteRule ^pates-tartiner\.html$     /categorie/pates-tartiner [R=301,L]
    RewriteRule ^huiles\.html$             /categorie/huiles [R=301,L]
    RewriteRule ^coffrets\.html$           /categorie/coffrets [R=301,L]

    # Route /categorie/<slug> → categorie.html?cat=<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^categorie/([^/]+)/?$ categorie.html?cat=$1 [L,QSA]

    # Route /produit/<slug> → Fiche Produit.html?slug=<slug>
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^produit/([^/]+)/?$ Fiche Produit.html?slug=$1 [L,QSA]
</IfModule>

# ── 5. data.php : jamais mis en cache (données dynamiques) ──
<FilesMatch "^data\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set Surrogate-Control "no-store"
</FilesMatch>

# ── 5bis. HTML : toujours revalider pour éviter les vieilles pages en prod ──
<FilesMatch "\.(html?)$">
    Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# ── 6. Cache statique pour les assets ─────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>
